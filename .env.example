# Copy to .env (never commit .env). ASP.NET Core maps `Section__Key` environment variables to configuration.

# PostgreSQL. Local: docker compose. Neon: use the DIRECT (non-pooler) host, SSL Mode=Require.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=messenger;Username=messenger;Password=messenger;Maximum Pool Size=10

# HS256 signing secret, at least 32 bytes. Generate: openssl rand -base64 48
# Production refuses to start without it.
Jwt__Secret=
Jwt__AccessTtlMinutes=12

Auth__RefreshTtlDays=21
Auth__RefreshGraceSeconds=20
Auth__RequireEmailVerification=true

# Email: Mailpit (local SMTP on :1025, UI on :8025), Brevo (production HTTP API) or None.
Email__Provider=Mailpit
Email__From=Migly <no-reply@example.com>
Email__SmtpHost=localhost
Email__SmtpPort=1025
Email__BrevoApiKey=

# Web Push (optional). Generate: npx web-push generate-vapid-keys
Vapid__PublicKey=
Vapid__PrivateKey=
Vapid__Subject=mailto:you@example.com

# OAuth (optional). Redirect URIs: https://<host>/signin-google and https://<host>/signin-github
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=
Authentication__GitHub__ClientId=
Authentication__GitHub__ClientSecret=

# Public URL used in email links (the SPA routes /verify-email and /reset-password).
App__PublicBaseUrl=http://localhost:5173

# true behind Render's proxy so rate limiting sees real client IPs.
ForwardedHeaders__TrustProxy=false

RateLimiting__GlobalPerMinute=60
RateLimiting__AuthPerMinute=10

# Password for demo accounts created by `dotnet run --project server/src/Messenger.Api -- seed`.
Seed__Password=

# --- AI summary service (ai/, Python). Copy this file to `.env` in the repository root: the Python service reads it from
# there, wherever it is started. The .NET API does NOT read `.env`; it gets the Ai__* block below from
# server/src/Messenger.Api/appsettings.Development.local.json locally, or from environment variables on a server. ---
# anthropic | gemini | fake (fake needs no key: tests and local development)
AI_PROVIDER=fake
# Empty = the provider's default model (anthropic: claude-haiku-5-5, gemini: gemini-3.5-flash-lite).
AI_MODEL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Shared with the .NET API (header X-Ai-Secret), at least 16 characters: openssl rand -base64 24
AI_SHARED_SECRET=
AI_TIMEOUT_SECONDS=20
AI_MAX_MESSAGES=300

# --- AI summary ("що я пропустив"): the .NET side (not read from `.env`, see above). The Python service has the AI_* variables above. ---
# Off by default. When true, Ai__SharedSecret must be set (>= 16 chars) and equal AI_SHARED_SECRET of the Python service.
Ai__Enabled=false
Ai__BaseUrl=http://127.0.0.1:8000
# Fewer unread messages than this are not summarized (no LLM call).
Ai__MinMessages=2
Ai__SharedSecret=
