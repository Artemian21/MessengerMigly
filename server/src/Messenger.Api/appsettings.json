{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Secret": "",
    "AccessTtlMinutes": 12
  },
  "Auth": {
    "RefreshTtlDays": 21,
    "RefreshGraceSeconds": 20,
    "EmailVerificationTtlHours": 24,
    "PasswordResetTtlMinutes": 45,
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15,
    "RequireEmailVerification": true
  },
  "PasswordHashing": {
    "WorkFactor": 11
  },
  "Email": {
    "Provider": "Mailpit",
    "From": "Migly <no-reply@migly.local>",
    "SmtpHost": "localhost",
    "SmtpPort": 1025
  },
  "RateLimiting": {
    "GlobalPerMinute": 60,
    "AuthPerMinute": 10,
    "SendBurst": 10,
    "SendPerMinute": 30
  },
  "Presence": {
    "GraceSeconds": 7
  },
  "App": {
    "PublicBaseUrl": "http://localhost:5000"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "ForwardedHeaders": {
    "TrustProxy": false
  }
}
